// ============================================================================
// main.asc - host-side runner for the matmul kernel.
//
// The host wrapper is intentionally generic: shapes and dtypes come from
// ./input/dims.txt and the harness constants below, so porting to a new problem
// size is a scripts/gen_data.py edit, not a main.asc edit.
//
// Op spec (see README.md):
//     A : [M, K] fp16
//     B : [K, N] fp16
//     C : [M, N] fp32      C = A @ B   (products accumulated in fp32)
//
// Usage: ./matmul_custom        with  ./input/{a,b}.bin and ./input/dims.txt
// ============================================================================

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include <fstream>

#include "acl/acl.h"

// ---- TensorInfo ABI shared with the kernel dispatch layer. -----------------
#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
// Dtype enum for TensorInfo.dtype:
// 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64
// 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "data_utils.h"

// The kernel + run_kernel() live in kernel.asc, which is #included here so the
// host wrapper and the device entry share one translation unit.
#include "kernel.asc"

#define ACL_CHECK(expr)                                                                        \
    do {                                                                                       \
        aclError _ret = (expr);                                                                \
        if (_ret != ACL_SUCCESS) {                                                             \
            fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, \
                    (int)_ret);                                                                \
            return 1;                                                                          \
        }                                                                                      \
    } while (0)

#define FILE_CHECK(expr)                                                       \
    do {                                                                       \
        if (!(expr)) {                                                         \
            fprintf(stderr, "[ERROR] File I/O failed at %s:%d\n", __FILE__,    \
                    __LINE__);                                                 \
            return 1;                                                          \
        }                                                                      \
    } while (0)

// Dtype codes for this operator. Override them together with the reference
// implementation in scripts/MatMul.py if you change the precision policy.
static constexpr int32_t kDtypeA = 1;  // fp16
static constexpr int32_t kDtypeB = 1;  // fp16
static constexpr int32_t kDtypeC = 0;  // fp32

static size_t DtypeBytes(int32_t dtype)
{
    switch (dtype) {
        case 0:  // fp32
        case 5:  // int32
        case 9:  // uint32
            return 4;
        case 1:  // fp16
        case 2:  // bf16
        case 4:  // int16
        case 8:  // uint16
            return 2;
        case 6:  // int64
        case 10: // uint64
            return 8;
        case 3:  // int8
        case 7:  // uint8
        case 11: // bool
            return 1;
        default:
            return 0;
    }
}

// ./input/dims.txt holds three whitespace separated integers: M K N.
static bool ReadDims(const char* path, int64_t& M, int64_t& K, int64_t& N)
{
    std::ifstream f(path);
    if (!f.is_open()) {
        return false;
    }
    if (!(f >> M >> K >> N)) {
        return false;
    }
    return M > 0 && K > 0 && N > 0;
}

int main()
{
    int64_t M = 0, K = 0, N = 0;
    if (!ReadDims("./input/dims.txt", M, K, N)) {
        fprintf(stderr,
                "[ERROR] could not read M/K/N from ./input/dims.txt "
                "(expected e.g. '256 256 256')\n");
        return 1;
    }

    const int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum));
    ACL_CHECK(aclrtCreateStream(&stream));

    const size_t aElems = (size_t)M * (size_t)K;
    const size_t bElems = (size_t)K * (size_t)N;
    const size_t cElems = (size_t)M * (size_t)N;
    const size_t aBytes = aElems * DtypeBytes(kDtypeA);
    const size_t bBytes = bElems * DtypeBytes(kDtypeB);
    const size_t cBytes = cElems * DtypeBytes(kDtypeC);

    // Device-side shape/type descriptors handed to run_kernel().
    int64_t aShape[] = {M, K};
    int64_t bShape[] = {K, N};
    int64_t cShape[] = {M, N};
    TensorInfo aTensors[] = {{aShape, 2, kDtypeA}};
    TensorInfo bTensors[] = {{bShape, 2, kDtypeB}};
    TensorInfo cTensors[] = {{cShape, 2, kDtypeC}};
    TensorGroupInfo info_a = {aTensors, 1};
    TensorGroupInfo info_b = {bTensors, 1};
    TensorGroupInfo info_c = {cTensors, 1};

    uint8_t *aHost = nullptr, *aDev = nullptr;
    uint8_t *bHost = nullptr, *bDev = nullptr;
    uint8_t *cHost = nullptr, *cDev = nullptr;

    ACL_CHECK(aclrtMallocHost((void**)&aHost, aBytes));
    ACL_CHECK(aclrtMalloc((void**)&aDev, aBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/a.bin", aBytes, aHost, aBytes));
    ACL_CHECK(aclrtMemcpy(aDev, aBytes, aHost, aBytes, ACL_MEMCPY_HOST_TO_DEVICE));

    ACL_CHECK(aclrtMallocHost((void**)&bHost, bBytes));
    ACL_CHECK(aclrtMalloc((void**)&bDev, bBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/b.bin", bBytes, bHost, bBytes));
    ACL_CHECK(aclrtMemcpy(bDev, bBytes, bHost, bBytes, ACL_MEMCPY_HOST_TO_DEVICE));

    ACL_CHECK(aclrtMallocHost((void**)&cHost, cBytes));
    ACL_CHECK(aclrtMalloc((void**)&cDev, cBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemset(cDev, cBytes, 0, cBytes));

    fprintf(stdout, "[matmul] M=%lld K=%lld N=%lld, cores=%lld\n", (long long)M, (long long)K,
            (long long)N, (long long)availableCoreNum);

    run_kernel((GM_ADDR)aDev, info_a, (GM_ADDR)bDev, info_b, (GM_ADDR)cDev, info_c,
               availableCoreNum, stream);

    auto sync_ret = aclrtSynchronizeStreamWithTimeout(stream, 120000);
    if (sync_ret != ACL_SUCCESS) {
        fprintf(stderr, "[ERROR] aclrtSynchronizeStreamWithTimeout failed, ret=%d\n", (int)sync_ret);
        return 1;
    }

    ACL_CHECK(aclrtMemcpy(cHost, cBytes, cDev, cBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    FILE_CHECK(WriteFile("./output/c.bin", cHost, cBytes));

    if (aDev) aclrtFree(aDev);
    if (aHost) aclrtFreeHost(aHost);
    if (bDev) aclrtFree(bDev);
    if (bHost) aclrtFreeHost(bHost);
    if (cDev) aclrtFree(cDev);
    if (cHost) aclrtFreeHost(cHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}

// ============================================================================
// kernel.asc - the matmul kernel.  >>> This is the file you write. <<<
//
// It is #included by main.asc (one bisheng translation unit holds host wrapper
// + device code), so do NOT add main(), `#pragma once`, or include guards, and
// do not add a `static` to run_kernel().
//
// The file ships with a correct, reasonably fast baseline built on the
// high-level Matmul API: C = A @ B with fp16 inputs, fp32 accumulation and fp32
// output.  Everything around it (build, host runner, tiling plumbing, data
// generation, verification) is done; swap the body / tiling strategy here to
// optimise or to support another precision policy.
//
// Contract with the host harness:
//   * Shapes arrive at runtime through TensorGroupInfo:
//       A = info_a.tensors[0].shape -> [M, K]
//       B = info_b.tensors[0].shape -> [K, N]
//       C = info_c.tensors[0].shape -> [M, N]
//   * dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64
//            7=uint8 8=uint16 9=uint32 10=uint64 11=bool
//   * Buffers a/b/c are device (GM) addresses owned by the caller.  run_kernel()
//     launches the kernel asynchronously on `stream`; the caller synchronises.
//   * run_kernel() must not leak device memory: any scratch it allocates it also
//     frees.
//
// Call-layer rules (see asc-devkit asc-ar-dev):
//   host C++  -> launches kernels only via <<<>>>
//   __global__ -> calls __aicore__ helpers; never calls another __global__
//   __aicore__ -> calls other __aicore__ code; never calls __global__ / host
//
// Before introducing a new AscendC API/overload/dtype here, look it up under
// ${DEVKIT}/docs/zh/api and cross-check ${DEVKIT}/include + ${DEVKIT}/impl.
// ============================================================================

#include <cstdint>
#include <cstdio>
#include <cstdlib>

#include "kernel_tiling/kernel_tiling.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "kernel_operator.h"

#ifndef ASCENDC_CUBE_ONLY
#define ASCENDC_CUBE_ONLY
#endif
#include "lib/matmul_intf.h"

namespace matmul_custom_ns {

// ---------------------------------------------------------------------------
// Problem configuration for the baseline.  A and B are row-major / "ND"; you
// can flip kIsTransA / kIsTransB (and the matching tiling SetXType flags) to
// consume transposed inputs.
// ---------------------------------------------------------------------------
constexpr bool kIsTransA = false;
constexpr bool kIsTransB = false;

// ---- device: pull TCubeTiling out of GM into a register struct ------------
__aicore__ inline void CopyTiling(TCubeTiling* tiling, GM_ADDR tilingGm)
{
    uint32_t* ptr = reinterpret_cast<uint32_t*>(tiling);
    auto tiling32 = reinterpret_cast<__gm__ uint32_t*>(tilingGm);
    for (uint32_t i = 0; i < sizeof(TCubeTiling) / sizeof(uint32_t); i++, ptr++) {
        *ptr = *(tiling32 + i);
    }
}

// ---------------------------------------------------------------------------
// MatmulKernel - thin wrapper around AscendC::Matmul.
//
// Each AI Core owns a (singleCoreM x singleCoreN) output tile and loops over K
// inside IterateAll().  Block (0,0) is top-left; blocks march along M fastest,
// then N, matching CalcOffset() below and the tiling produced on the host.
// ---------------------------------------------------------------------------
template <typename AType, typename BType, typename CType, typename BiasType>
class MatmulKernel {
public:
    __aicore__ inline MatmulKernel() {}

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR bias, GM_ADDR c,
                                const TCubeTiling& tiling);
    __aicore__ inline void Process(AscendC::TPipe* pipe);

    AscendC::Matmul<
        AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, AType>,
        AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, BType>,
        AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, CType>,
        AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, BiasType>, CFG_NORM>
        matmulObj;

private:
    __aicore__ inline void CalcOffset(int32_t blockIdx, int32_t& offsetA, int32_t& offsetB,
                                      int32_t& offsetC, int32_t& offsetBias);

    AscendC::GlobalTensor<AType> aGlobal;
    AscendC::GlobalTensor<BType> bGlobal;
    AscendC::GlobalTensor<CType> cGlobal;
    AscendC::GlobalTensor<BiasType> biasGlobal;
    TCubeTiling tiling;
};

template <typename AType, typename BType, typename CType, typename BiasType>
__aicore__ inline void MatmulKernel<AType, BType, CType, BiasType>::Init(
    GM_ADDR a, GM_ADDR b, GM_ADDR bias, GM_ADDR c, const TCubeTiling& tilingIn)
{
    this->tiling = tilingIn;

    aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ AType*>(a), tiling.M * tiling.Ka);
    bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ BType*>(b), tiling.Kb * tiling.N);
    cGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ CType*>(c), tiling.M * tiling.N);
    if (tiling.isBias) {
        biasGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ BiasType*>(bias), tiling.N);
    }

    int32_t offsetA = 0;
    int32_t offsetB = 0;
    int32_t offsetC = 0;
    int32_t offsetBias = 0;
    CalcOffset((int32_t)AscendC::GetBlockIdx(), offsetA, offsetB, offsetC, offsetBias);
    aGlobal = aGlobal[offsetA];
    bGlobal = bGlobal[offsetB];
    cGlobal = cGlobal[offsetC];
    if (tiling.isBias) {
        biasGlobal = biasGlobal[offsetBias];
    }
}

template <typename AType, typename BType, typename CType, typename BiasType>
__aicore__ inline void MatmulKernel<AType, BType, CType, BiasType>::Process(AscendC::TPipe* pipe)
{
#if __NPU_ARCH__ == 2002
    // Pre-2201 parts need a UB scratch window for the internal ND<->NZ layout
    // conversion; dav-2201 / dav-3510 do not.
    AscendC::TBuf<> tmpMMFormatUb;
    pipe->InitBuffer(tmpMMFormatUb, AscendC::TOTAL_VEC_LOCAL_SIZE);
    matmulObj.SetLocalWorkspace(tmpMMFormatUb.Get<uint8_t>(AscendC::TOTAL_VEC_LOCAL_SIZE));
#endif
    matmulObj.SetTensorA(aGlobal, kIsTransA);
    matmulObj.SetTensorB(bGlobal, kIsTransB);
    if (tiling.isBias) {
        matmulObj.SetBias(biasGlobal);
    }
    matmulObj.IterateAll(cGlobal);
    matmulObj.End();
}

template <typename AType, typename BType, typename CType, typename BiasType>
__aicore__ inline void MatmulKernel<AType, BType, CType, BiasType>::CalcOffset(
    int32_t blockIdx, int32_t& offsetA, int32_t& offsetB, int32_t& offsetC, int32_t& offsetBias)
{
    auto mSingleBlocks = (tiling.M + tiling.singleCoreM - 1) / tiling.singleCoreM;
    auto mCoreIndx = blockIdx % mSingleBlocks;
    auto nCoreIndx = blockIdx / mSingleBlocks;

    offsetA = mCoreIndx * tiling.Ka * tiling.singleCoreM;
    if (kIsTransA) {
        offsetA = mCoreIndx * tiling.singleCoreM;
    }
    offsetB = nCoreIndx * tiling.singleCoreN;
    if (kIsTransB) {
        offsetB = nCoreIndx * tiling.Kb * tiling.singleCoreN;
    }
    offsetC = mCoreIndx * tiling.N * tiling.singleCoreM + nCoreIndx * tiling.singleCoreN;
    offsetBias = nCoreIndx * tiling.singleCoreN;

    // Tail block on the M and/or N edge.
    int tailM = tiling.M - mCoreIndx * tiling.singleCoreM;
    tailM = tailM < tiling.singleCoreM ? tailM : tiling.singleCoreM;
    int tailN = tiling.N - nCoreIndx * tiling.singleCoreN;
    tailN = tailN < tiling.singleCoreN ? tailN : tiling.singleCoreN;
    if (tailM < tiling.singleCoreM || tailN < tiling.singleCoreN) {
        matmulObj.SetTail(tailM, tailN);
    }
}

// ---------------------------------------------------------------------------
// Device entry.  One instance per dtype combination; the baseline only wires up
// fp16 x fp16 -> fp32 (see run_kernel()).
// ---------------------------------------------------------------------------
__global__ __cube__ void matmul_custom(GM_ADDR a, GM_ADDR b, GM_ADDR bias, GM_ADDR c,
                                       GM_ADDR workspace, GM_ADDR tilingGm)
{
    (void)workspace;  // system workspace is reached via GetSysWorkSpacePtr()
    TCubeTiling tiling;
    CopyTiling(&tiling, tilingGm);
    AscendC::TPipe pipe;

    MatmulKernel<half, half, float, float> kernel;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), kernel.matmulObj, &tiling);
    kernel.Init(a, b, bias, c, tiling);
    kernel.Process(&pipe);
}

// ---------------------------------------------------------------------------
// Host-side tiling generation.  Returns the number of AI Cores the tiling
// actually uses, or -1 on failure.
// ---------------------------------------------------------------------------
inline int32_t GenerateTiling(platform_ascendc::PlatformAscendC& platform, uint8_t* tilingBuf,
                              int64_t M, int64_t N, int64_t K, uint32_t coreNum)
{
    optiling::TCubeTiling tilingData;
    matmul_tiling::MultiCoreMatmulTiling tilingApi(platform);
    tilingApi.SetDim(coreNum);
    tilingApi.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                       matmul_tiling::DataType::DT_FLOAT16, kIsTransA);
    tilingApi.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                       matmul_tiling::DataType::DT_FLOAT16, kIsTransB);
    tilingApi.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                       matmul_tiling::DataType::DT_FLOAT);
    tilingApi.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                          matmul_tiling::DataType::DT_FLOAT);

    tilingApi.SetOrgShape(M, N, K);
    tilingApi.SetShape(M, N, K);
    tilingApi.EnableBias(false);
    tilingApi.SetBufferSpace(-1, -1, -1);

    int64_t res = tilingApi.GetTiling(tilingData);
    if (res == -1) {
        return -1;
    }
    tilingData.SaveToBuffer(tilingBuf, tilingData.GetDataSize());
    return (int32_t)tilingData.get_usedCoreNum();
}

}  // namespace matmul_custom_ns

// ---------------------------------------------------------------------------
// run_kernel - host entry called by main.asc.
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR a, const TensorGroupInfo& info_a, GM_ADDR b,
                           const TensorGroupInfo& info_b, GM_ADDR c,
                           const TensorGroupInfo& info_c, int64_t availableCoreNum,
                           aclrtStream stream)
{
    using namespace matmul_custom_ns;

    const TensorInfo& aInfo = info_a.tensors[0];
    const TensorInfo& bInfo = info_b.tensors[0];
    (void)info_c;

    if (aInfo.dtype != 1 || bInfo.dtype != 1) {
        fprintf(stderr, "[matmul] baseline supports fp16 inputs only (a.dtype=%d, b.dtype=%d)\n",
                aInfo.dtype, bInfo.dtype);
        return;
    }

    const int64_t M = aInfo.shape[0];
    const int64_t K = aInfo.shape[1];
    const int64_t N = bInfo.shape[1];

    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) {
        fprintf(stderr, "[matmul] failed to get PlatformAscendC instance\n");
        return;
    }

    int32_t aicNum = (int32_t)platform->GetCoreNumAic();
    uint32_t coreNum = (aicNum > 0) ? (uint32_t)aicNum
                                    : ((availableCoreNum > 0) ? (uint32_t)availableCoreNum : 1u);

    const size_t tilingBytes = sizeof(TCubeTiling);
    uint8_t* tilingHost = (uint8_t*)malloc(tilingBytes);
    if (tilingHost == nullptr) {
        fprintf(stderr, "[matmul] failed to allocate host tiling buffer\n");
        return;
    }

    int32_t usedCoreNum = GenerateTiling(*platform, tilingHost, M, N, K, coreNum);
    if (usedCoreNum <= 0) {
        fprintf(stderr, "[matmul] tiling generation failed for M=%lld N=%lld K=%lld\n", (long long)M,
                (long long)N, (long long)K);
        free(tilingHost);
        return;
    }

    void* tilingDev = nullptr;
    if (aclrtMalloc(&tilingDev, tilingBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        fprintf(stderr, "[matmul] failed to allocate device tiling buffer\n");
        free(tilingHost);
        return;
    }
    aclrtMemcpy(tilingDev, tilingBytes, tilingHost, tilingBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    // System workspace the Matmul library needs during IterateAll().
    size_t workspaceBytes = (size_t)platform->GetLibApiWorkSpaceSize();
    void* workspaceDev = nullptr;
    if (workspaceBytes > 0 &&
        aclrtMalloc(&workspaceDev, workspaceBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        fprintf(stderr, "[matmul] failed to allocate device workspace\n");
        aclrtFree(tilingDev);
        free(tilingHost);
        return;
    }

    matmul_custom<<<(uint32_t)usedCoreNum, nullptr, stream>>>(a, b, nullptr, c,
                                                             (GM_ADDR)workspaceDev,
                                                             (GM_ADDR)tilingDev);

    // tilingDev / workspaceDev are owned by this call and the kernel is async,
    // so drain the stream before releasing them.  main.asc syncs again later.
    aclrtSynchronizeStream(stream);
    if (tilingDev) aclrtFree(tilingDev);
    if (workspaceDev) aclrtFree(workspaceDev);
    free(tilingHost);
}
